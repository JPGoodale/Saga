module sgemm_128x256x8 

@threads(256)
@blocks_per_sm(1)
main :: kernel(A: [M, K]f32, B: [K, N]f32, alpha, beta: f32, lda, ldb: ldc: u32) -> (C: [M, N]f32) {
    A_smem_padding  := 256
    A_smem_size     := A_smem_padding * 8
    A_smem_load     := 132

    B_smem_padding  := 256
    B_smem_size     := B_smem_padding * 8
    B_smem_load     := 256

    #align(2 * A_smem_size * size_of(f32)) {
        smem_ptr: [2*(A_smem_size + B_smem_size)]f32
    }

    A_smem_ptr := smem_ptr
    B_smem_ptr := smem_ptr + 2 * smem_size

    accumulator: [16][8]f32

    A_gmem_load_bitmask, B_gmem_load_bitmask := 0x0, 0x0

    A_gmem_load_start_x := thread.x % 8
    A_gmem_load_start_y := block.y * 128 + thread.x / 8
    A_gmem_load_start   := A_gmem_load_start_x + A_gmem_load_start_y * lda
    A_gmem_load_ptr     := A + A_gmem_load_start

    A_gmem_offsets:     [4]u32
    A_gmem_offsets_y:   [4]u32

    for i in 0..4 {
        A_gmem_offsets_y[i] := i * 32
    }
    for i in 0..4 {
        A_gmem_offsets[i] := A_gmem_offsets_y[i] * lda
    }
    for i in 0..4 {
        m_idx := A_gmem_load_start_y + A_gmem_offsets_y[i]
        if m_idx < m {
            A_gmem_load_bitmask ^= 0x1 << i)
        }
    }

    B_gmem_load_start_x := block.x * 256 + thread.x % 128
    B_gmem_load_start_y := thread.x / 128
    B_gmem_load_start   := B_gmem_load_start_x + B_gmem_load_start_y * ldb
    B_gmem_load_ptr     := B + B_gmem_load_start

    for i in 0..2 {
        n_idx := B_gmem_load_start_x + i * 128
        if n_idx < n {
            B_gmem_load_bitmask ^= 0x1 << i)
        }
    }

    A_smem_store_start_x := thread.x / 8
    A_smem_store_start_y := thread.x % 8 
    A_smem_store_start   := A_smem_store_start_x + A_smem_store_start_y * A_smem_load
    A_smem_store_ptr     := A_smem_ptr + A_smem_store_start
    
    B_smem_store_start_x := thread.x % 128
    B_smem_store_start_y := thread.x / 128 
    B_smem_store_start   := B_smem_store_start_x + B_smem_store_start_y * B_smem_load
    B_smem_store_ptr     := B_smem_ptr + B_smem_store_start

    A_smem_store_addr: u64
    B_smem_store_addr: u64

    CVTA_TO_SHARED_PTX(A_smem_store_addr, A_smem_store_ptr)
    CVTA_TO_SHARED_PTX(B_smem_store_addr, B_smem_store_ptr)

    n_blocks_k := (K + 7) / 8 - 1
    first_block_k_size = K - 8 * n_blocks_k

    for i in 0..4 {
        guard_k := A_gmem_load_start_x < first_block_k_size
        guard_m := A_gmem_load_bitmask & (0x1 << i)
        guard   := guard_k && guard_m
        CP_ASYNC_IGNORE_SRC_PTX(
            A_smem_store_addr + i * 32 * size_of(f32),
            A_gmem_load_ptr + A_gmem_load_offsets[i],
            cast(u32)guard
        )
    }
    for i in 0..4 {
        guard_k := (2 * i + thread.x / 128) < first_block_k_size
        guard_n := B_gmem_load_bitmask & (0x1 << 0)
        guard   := guard_k && guard_n
        CP_ASYNC_IGNORE_SRC_PTX(
            B_smem_store_addr + i * 2 * 256 * size_of(f32),
            B_gmem_load_ptr + i * 2 * ldb,
            cast(u32)guard
        )
        guard_n := B_gmem_load_bitmask & (0x1 << 1)
        guard   := guard_k && guard_n
        CP_ASYNC_IGNORE_SRC_PTX(
            B_smem_store_addr + (i * 2 * 256 + 128) * size_of(f32),
            B_gmem_load_ptr + i * 2 * ldb + 128,
            cast(u32)guard
        )
    }

    WAIT_ALL_PTX
    sync_threads()

    A_gmem_load_ptr     += first_block_k_size
    B_gmem_load_ptr     += first_block_k_size * ldb
    A_smem_store_addr   ^= 8192
    B_smem_store_add    ^= 8192

    A_frag: [2][16]f32
    B_frag: [2][8]f32

    A_smem_load_addr: u64
    B_smem_load_addr: u64

    lane_id_mapped_x := 2 * (lane / 8) + (lane % 2)
    lane_id_mapped_y := (lane / 2) % 4
    warp_id_mapped_x := 64 * (warp % 4)
    warp_id_mapped_y := 64 * (warp / 4) 

    A_smem_load_offset  := 4 * lane_id_mapped_y + warp_id_mapped_y
    B_smem_load_offset  := 4 * lane_id_mapped_x + warp_id_mapped_x
    A_smem_load_ptr     := A_smem_ptr + A_smem_load_offset
    B_smem_load_ptr     := B_smem_ptr + B_smem_load_offset 

    CVTA_TO_SHARED_PTX(A_smem_load_addr, A_smem_load_ptr)
    CVTA_TO_SHARED_PTX(B_smem_load_addr, B_smem_load_ptr)

    LDS128_PTX(A_frag[0][0], A_frag[0][1], A_frag[0][2], A_frag[0][3], A_smem_load_addr)
    LDS128_PTX(A_frag[0][4],
               A_frag[0][5],
               A_frag[0][6],
               A_frag[0][7],
               A_smem_load_addr + 16 * size_of(f32))
    LDS128_PTX(A_frag[0][8],
               A_frag[0][9],
               A_frag[0][10],
               A_frag[0][11],
               A_smem_load_addr + 32 * size_of(f32))
    LDS128_PTX(A_frag[0][12],
               A_frag[0][13],
               A_frag[0][14],
               A_frag[0][15],
               A_smem_load_addr + 48 * size_of(f32))
    LDS128_PTX(B_frag[0][0], B_frag[0][1], B_frag[0][2], B_frag[0][3], B_smem_load_addr)
    LDS128_PTX(B_frag[0][4],
               B_frag[0][5],
               B_frag[0][6],
               B_frag[0][7],
               B_smem_load_addr + 32 * size_of(f32))
    
    for block_ks := 0; block_ks < n_blocks_k; block_ks+=1 {
        for warp_k := 0; warp_k < 7; warp_k += 1 {
           prefetch := warp_k + 1 
           frag_idx := warp_k & 1
           frag_next_idx := (warp_k + 1) & 1

            LDS128_PTX(B_frag[frag_next_idx][0],
                       B_frag[frag_next_idx][1],
                       B_frag[frag_next_idx][2],
                       B_frag[frag_next_idx][3],
                       B_smem_load_addr + prefetch * B_smem_load * size_of(f32))
            LDS128_PTX(B_frag[frag_next_idx][4],
                       B_frag[frag_next_idx][5],
                       B_frag[frag_next_idx][6],
                       B_frag[frag_next_idx][7],
                       B_smem_load_addr + (prefetch * B_smem_load + 32) * size_of(f32))

            LDS128_PTX(A_frag[frag_next_idx][0],
                       A_frag[frag_next_idx][1],
                       A_frag[frag_next_idx][2],
                       A_frag[frag_next_idx][3],
                       A_smem_load_addr + prefetch * A_smem_load * size_of(f32))
            LDS128_PTX(A_frag[frag_next_idx][4],
                       A_frag[frag_next_idx][5],
                       A_frag[frag_next_idx][6],
                       A_frag[frag_next_idx][7],
                       A_smem_load_addr + (prefetch * A_smem_load + 16) * size_of(f32))

            LDS128_PTX(A_frag[frag_next_idx][8],
                       A_frag[frag_next_idx][9],
                       A_frag[frag_next_idx][10],
                       A_frag[frag_next_idx][11],
                       A_smem_load_addr + (prefetch * A_smem_load + 32) * size_of(f32))

            LDS128_PTX(A_frag[frag_next_idx][12],
                       A_frag[frag_next_idx][13],
                       A_frag[frag_next_idx][14],
                       A_frag[frag_next_idx][15],
                       A_smem_load_addr + (prefetch * A_smem_load + 48) * size_of(f32))


            if warp_k < 4 {
                guard := A_gmem_load_bitmask & (0x1 << warp_k)
                CP_ASYNC_GUARD_PTX(A_smem_store_addr + warp_k * 32 * size_of(f32),
                                   A_gmem_load_ptr + A_gmem_load_offsets[warp_k],
                                   cast(u32)guard)

                guard = B_gmem_load_bitmask & (0x1 << 0)
                CP_ASYNC_GUARD_PTX(B_smem_store_addr + warp_k * 2 * 256 * size_of(f32),
                                   B_gmem_load_ptr + warp_k * 2 * ldb,
                                   cast(u32)guard)
                guard = B_gmem_load_bitmask & (0x1 << 1)
                CP_ASYNC_GUARD_PTX(B_smem_store_addr + (warp_k * 2 * 256 + 128) * size_of(f32),
                                   B_gmem_load_ptr + warp_k * 2 * ldb + 128,
                                   cast(u32)guard)
            }

            for i in 0..16 {
                for j in 0..8 {
                    accumulator[i][j] += A_frag[frag_idx][i] * B_frag[frag_idx][j]
                }
            }
        }

        for i in 0..16 {
            for j in 0..8 {
                accumulator[i][j] += A_frag[1][i] * B_frag[1][j]
            }
        }

        WAIT_ALL_PTX
        sync_threads()

        A_smem_store_addr   ^= 8192
        B_smem_store_addr   ^= 8192
        A_smem_load_addr    ^= 8192
        B_smem_load_addr    ^= 8192

        LDS128_PTX(A_frag[0][0], A_frag[0][1], A_frag[0][2], A_frag[0][3], A_smem_load_addr)
        LDS128_PTX(A_frag[0][4],
                   A_frag[0][5],
                   A_frag[0][6],
                   A_frag[0][7],
                   A_smem_load_addr + 16 * size_of(f32))
        LDS128_PTX(A_frag[0][8],
                   A_frag[0][9],
                   A_frag[0][10],
                   A_frag[0][11],
                   A_smem_load_addr + 32 * size_of(f32))
        LDS128_PTX(A_frag[0][12],
                   A_frag[0][13],
                   A_frag[0][14],
                   A_frag[0][15],
                   A_smem_load_addr + 48 * size_of(f32))
        LDS128_PTX(B_frag[0][0], B_frag[0][1], B_frag[0][2], B_frag[0][3], B_smem_load_addr)
        LDS128_PTX(B_frag[0][4],
                   B_frag[0][5],
                   B_frag[0][6],
                   B_frag[0][7],
                   B_smem_load_addr + 32 * size_of(f32))

        A_gmem_load_ptr += 8
        B_gmem_load_ptr += 8 * N
    }


    for warp_k := 0; warp_k < 7; warp_k += 1 {
        prefetch        := warp_k + 1
        frag_idx        := warp_k & 1
        frag_next_idx   := (warp_k + 1) & 1

        LDS128_PTX(B_frag[frag_next_idx][0],
                   B_frag[frag_next_idx][1],
                   B_frag[frag_next_idx][2],
                   B_frag[frag_next_idx][3],
                   B_smem_load_addr + prefetch * B_smem_load * size_of(f32))
        LDS128_PTX(B_frag[frag_next_idx][4],
                   B_frag[frag_next_idx][5],
                   B_frag[frag_next_idx][6],
                   B_frag[frag_next_idx][7],
                   B_smem_load_addr + (prefetch * B_smem_load + 32) * size_of(f32))

        LDS128_PTX(frag_a[frag_next_idx][0],
                   frag_a[frag_next_idx][1],
                   frag_a[frag_next_idx][2],
                   frag_a[frag_next_idx][3],
                   A_smem_load_addr + prefetch * A_smem_load * size_of(f32))
        LDS128_PTX(frag_a[frag_next_idx][4],
                   frag_a[frag_next_idx][5],
                   frag_a[frag_next_idx][6],
                   frag_a[frag_next_idx][7],
                   A_smem_load_addr + (prefetch * A_smem_load + 16) * size_of(f32))
        LDS128_PTX(frag_a[frag_next_idx][8],
                   frag_a[frag_next_idx][9],
                   frag_a[frag_next_idx][10],
                   frag_a[frag_next_idx][11],
                   A_smem_load_addr + (prefetch * A_smem_load + 32) * size_of(f32))
        LDS128_PTX(frag_a[frag_next_idx][12],
                   frag_a[frag_next_idx][13],
                   frag_a[frag_next_idx][14],
                   frag_a[frag_next_idx][15],
                   A_smem_load_addr + (prefetch * A_smem_load + 48) * size_of(f32))

        for i in 0..16 {
            for j in 0..8 {
                accumulator[i][j] += A_frag[frag_idx][i] * B_frag[frag_idx][j]
            }
        }
    }

    for i in 0..16 {
        for j in 0..8 {
            accumulator[i][j] += A_frag[1][i] * B_frag[1][j]
        }
    }

    for i in 0..16 {
        for j in 0..8 {
            accumulator[i][j] *= alpha
        }
    }
    
    C_smem_store_addr: u64
    C_smem_store_offset := 512 * warp + 4 * 4 * 8 * lane_id_mapped_y + 4 * lane_id_mapped_x
    CVTA_TO_SHARED_PTX(C_smem_store_addr, smem_ptr + C_smem_store_offset)
    
    C_smem_load_ptr := cast(^f32)(smem_ptr + 512 * warp + lane)

    m_idx := block.y * 128 + warp_id_mapped_y
    n_idx := block.x * 256 + warp_id_mapped_x + lane
    C_smem_store_ptr := C + m_idx * ldc + n_idx

    if m_idx < M {
        for i in 0..4 {
            for j in 0..2 {
                sync_threads()
                for p in 0..4 {
                    STS128_PTX(accumulator[i * 4 + p][j * 4],
                               accumulator[i * 4 + p][j * 4 + 1],
                               accumulator[i * 4 + p][j * 4 + 2],
                               accumulator[i * 4 + p][j * 4 + 3],
                               C_smem_store_addr + p * 8 * (size_of(f32) * 4))
                }
                sync_threads()
                for p in 0..16 {
                    m_edge  := M - (m_idx + i * 16)
                    n_pos   := n_idx + j * 32
                    guard   := p < m_edge && n_pos < N
                    if beta != 0 {
                        c: f32
                        LDG32_GUARD_MOV0_PTX(c,
                                             C_gmem_store_ptr + (i * 16 + p) * n + j * 32,
                                             cast(u32)guard)
                        c *= beta
                        STG32_GUARD_PTX(c + C_smem_load_ptr[p * 32],
                                        C_gmem_ptr + (i * 16 + p) * n + j * 32,
                                        cast(u32)guard)
                    } else {
                        STG32_GUARD_PTX(C_smem_load_ptr[p * 32],
                                        C_gmem_ptr + (i * 16 + p) * n + j * 32,
                                        cast(u32)guard)
                    }
                }
            }
        }
    }
    return
}
