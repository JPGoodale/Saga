OpCapability Shader
%glsl = OpExtInstImport "GLSL.std.450"
OpMemoryModel Logical GLSL450
OpEntryPoint GLCompute %main "main" %gl_GlobalInvocationID
OpExecutionMode %main LocalSize 128 1 1
OpDecorate %gl_GlobalInvocationID BuiltIn GlobalInvocationId
OpDecorate %_rtarray_float32 ArrayStride 4
OpDecorate %_structured_rtarray_float32 Block 
OpMemberDecorate %_structured_rtarray_float32 0 Offset 0
OpDecorate %out DescriptorSet 0
OpDecorate %out Binding 0
OpDecorate %input DescriptorSet 0
OpDecorate %input Binding 1
OpDecorate %weight DescriptorSet 0
OpDecorate %weight Binding 2
OpMemberDecorate %push_constant 0 Offset 0
OpDecorate %push_constant Block 
%uint32 = OpTypeInt 32 0
%float32 = OpTypeFloat 32 
%bool = OpTypeBool
%uint32_0 = OpConstant %uint32 0
%float32_1_0 = OpConstant %float32 1
%v3uint32 = OpTypeVector %uint32 3
%_ptr_Input_v3uint32 = OpTypePointer Input %v3uint32
%void = OpTypeVoid
%func_result = OpTypeFunction %void 
%_ptr_StorageBuffer_float32 = OpTypePointer StorageBuffer %float32
%_rtarray_float32 = OpTypeRuntimeArray %float32
%_structured_rtarray_float32 = OpTypeStruct %_rtarray_float32
%_ptr_StorageBuffer_structured_rtarray_float32 = OpTypePointer StorageBuffer %_structured_rtarray_float32
%push_constant = OpTypeStruct %uint32
%_ptr_push_constant = OpTypePointer PushConstant %push_constant
%_ptr_push_constant_uint32 = OpTypePointer PushConstant %uint32
%_ptr_Function_float32 = OpTypePointer Function %float32
%gl_GlobalInvocationID = OpVariable %_ptr_Input_v3uint32 Input 
%out = OpVariable %_ptr_StorageBuffer_structured_rtarray_float32 StorageBuffer 
%input = OpVariable %_ptr_StorageBuffer_structured_rtarray_float32 StorageBuffer 
%weight = OpVariable %_ptr_StorageBuffer_structured_rtarray_float32 StorageBuffer 
%n = OpVariable %_ptr_push_constant PushConstant 
%main = OpFunction %void None %func_result
%body = OpLabel
%temp = OpVariable %_ptr_Function_float32 Function %float32_1_0
%layout_ptr = OpLoad %v3uint32 %gl_GlobalInvocationID 
%max_thread_id_x = OpCompositeExtract %uint32 %layout_ptr 0
%n_access_chain = OpAccessChain %_ptr_push_constant_uint32 %n %uint32_0
%n_register = OpLoad %uint32 %n_access_chain 
%condition_1 = OpULessThan %bool %max_thread_id_x %n_register
OpSelectionMerge %block_end None
OpBranchConditional %condition_1 %block_start %block_end 
%block_start = OpLabel
%weight_access_chain = OpAccessChain %_ptr_StorageBuffer_float32 %weight %uint32_0 %max_thread_id_x
%weight_register = OpLoad %float32 %weight_access_chain 
%input_access_chain = OpAccessChain %_ptr_StorageBuffer_float32 %input %uint32_0 %max_thread_id_x
%input_register = OpLoad %float32 %input_access_chain 
%product_2 = OpFMul %float32 %weight_register %input_register
%out_access_chain = OpAccessChain %_ptr_StorageBuffer_float32 %out %uint32_0 %max_thread_id_x
OpStore %out_access_chain %product_2 
OpBranch %block_end
%block_end = OpLabel
OpReturn
OpFunctionEnd
